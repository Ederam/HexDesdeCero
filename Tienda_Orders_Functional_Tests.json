          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Código de respuesta es 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
